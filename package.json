    "type": "module",
    "keywords": [
        "pi-package",
        "pi-extension",
        "anthropic",
        "oauth",
        "console"
    ],
    "license": "MIT",
    "pi": {
        "extensions": ["./index.ts"]
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-ai": {
            "optional": true
        },
        "@earendil-works/pi-coding-agent": {
            "optional": true
        }
    }
}
